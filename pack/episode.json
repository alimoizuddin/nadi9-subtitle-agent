      "note": "Ravi's younger sister"
    },
    {
      "id": "KAMLA",
      "name": "Kamla",
      "age": 55,
      "note": "Mother of Ravi and Meera"
    },
    {
      "id": "SONU",
      "name": "Sonu",
      "age": 31,
      "note": "Ravi's childhood friend"
    },
    {
