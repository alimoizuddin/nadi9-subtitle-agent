{
  "precedence_policy": [
    {
      "family": "correction",
      "rule": "Named linguist correction received during the run. Highest, but logged and reversible."
    },
    {
      "family": "example",
      "rule": "Approved examples, unless a well-supported rule marks one as suspect."
    },
    {
      "family": "dictB",
      "rule": "Community dictionary. Weighted by measured agreement with examples."
    },
    {
      "family": "expert",
      "rule": "Expert notes. Kept visible when experts disagree; can add caution, never remove it."
    },
    {
      "family": "grammar",
      "rule": "Grammar note. Every rule is tested against examples before use."
    },
    {
      "family": "interview",
      "rule": "Interview transcripts. The interviewer's translation is loose: supports, never decides."
    },
    {
      "family": "dictA",
      "rule": "Vendor dictionary. Largest file, weighted by measured agreement; single-source meanings go to review."
    },
    {
      "family": "feedback",
      "rule": "Viewer feedback. Never evidence for a word. Can raise the priority of a review."
    },
    {
      "family": "model",
      "rule": "Model output. Never evidence. Every claim it makes is checked against the sources above."
    }
  ],
